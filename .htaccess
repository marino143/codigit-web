# codigit.hr — minimal config after migration to codigit.io (Netlify)
# Purpose: 301 redirect ALL web traffic to codigit.io, preserving paths.
# Email (MX records) is unaffected — handled separately by cPanel DNS.

DirectoryIndex index.html index.php

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Force HTTPS first (so we redirect to the correct scheme)
    RewriteCond %{HTTPS} !=on
    RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [L,R=301]

    # Force non-www
    RewriteCond %{HTTP_HOST} ^www\.codigit\.hr$ [NC]
    RewriteRule ^(.*)$ https://codigit.hr/$1 [L,R=301]

    # 301 redirect EVERYTHING to codigit.io (preserve path + query string)
    RewriteCond %{HTTP_HOST} ^codigit\.hr$ [NC]
    RewriteRule ^(.*)$ https://codigit.io/$1 [L,R=301]
</IfModule>

# Block sensitive files (still applies to anything not redirected)
<FilesMatch "^\.(htaccess|htpasswd|git|env|cpanel\.yml)|\.(bak|config|sql|ini|log)$">
    Require all denied
</FilesMatch>

# Prevent directory listing
Options -Indexes

# Disable server signature
ServerSignature Off
